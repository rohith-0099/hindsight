# Slack bot token (starts with xoxb-) — from OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack app-level token (starts with xapp-) — from Basic Information > App-Level Tokens, needs connections:write
SLACK_APP_TOKEN=xapp-your-app-token

# Groq API key — from https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-key

# Optional overrides
# llama-3.3-70b-versatile is deprecated (June 2026) on free/dev tier — use gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b
DB_PATH=data/hindsight.sqlite

# AUTO-CAPTURE: offer to remember messages that look like decisions (on/off, default on)
AUTOCAPTURE=on


